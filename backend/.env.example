# ============================================================================
# SafeGuard Backend — Environment Configuration
# Copy to .env and fill in your local MySQL credentials.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_DATABASE=safeguard

# ── Application ─────────────────────────────────────────────────────────────
APP_PORT=3001
NODE_ENV=development

# ── TypeORM ─────────────────────────────────────────────────────────────────
# Set to true only in development — auto-syncs entities to schema
TYPEORM_SYNC=true
